# scopus_tools 環境変数のサンプル
# このファイルをコピーして .env を作成し、各キーを実値に置き換えてください:
#   cp .env.example .env
# .env は .gitignore に登録済みなのでコミットされません。

# --- 必須 ---------------------------------------------------------

# Scopus API キー(ほぼ全コマンドで必要)
# https://dev.elsevier.com/ で発行。利用機関の IP からアクセスする必要があります。
SCOPUS_API_KEY=your_scopus_api_key_here

# --- AI 評価用(OpenAI / Anthropic のどちらか一方でも可) ------------

# Anthropic API キー(既定モデル claude-opus-4-7 に必要)
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# OpenAI API キー(gpt-* モデルを使う場合に必要)
# https://platform.openai.com/ で発行
OPENAI_API_KEY=sk-your_openai_key_here

# --- 任意 ---------------------------------------------------------

# CiNii アプリケーション ID(科研費 KAKEN 連携を使う場合に必要)
# https://support.nii.ac.jp/ja/cinii/api/developer で申請
KAKEN_APP_ID=your_cinii_application_id_here
